# Local development settings. Copy to .env only if it does not already exist.
# Supply your own private signing key; startup fails while this is blank.
SECRET_KEY=
# Only true (case-insensitive) enables debug; use False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave blank to use the local SQLite database.
DATABASE_URL=
# Optional for non-AI development and tests.
OPENAI_API_KEY=
