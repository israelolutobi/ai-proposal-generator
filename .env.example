# Local development settings. Copy to .env only if it does not already exist.
# Supply your own private signing key; startup fails while this is blank.
SECRET_KEY=
# Modes: development (default) or production. Invalid modes fail startup.
APP_ENV=development
# Booleans accept only True/False, case-insensitively. Use False in production.
DEBUG=True
# Production requires explicit real hosts without wildcard, scheme or port.
ALLOWED_HOSTS=localhost,127.0.0.1
# Empty is valid for same-origin deployment; production entries must use HTTPS.
CSRF_TRUSTED_ORIGINS=
# Blank uses SQLite only in development. Production requires PostgreSQL.
# The production operator must configure PostgreSQL TLS for the chosen provider.
DATABASE_URL=
# Optional for non-AI development and tests.
OPENAI_API_KEY=
# Development defaults enabled; production defaults disabled. Strict True/False.
AI_ENABLED=True
# Global ceilings may both be omitted in development or when production AI is off.
# Enabling production AI requires BOTH approved nonnegative decimal credit limits.
# No production thresholds have been selected. Zero blocks new AI admissions.
# Supplied blank values are invalid: leave these commented until values are approved.
# AI_GLOBAL_DAILY_CREDITS=
# AI_GLOBAL_WEEKLY_CREDITS=
# Local HTTP settings. For production set redirect=True and HSTS seconds=300.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Enable only in production behind an isolated proxy that overwrites scheme headers.
TRUST_PROXY_HEADERS=False
# Hosted Linux Gunicorn only; local runserver does not use these.
PORT=8000
WEB_CONCURRENCY=1
